ZYPP_INS="$ZYPP_INS man"
ZYPP_INS="$ZYPP_INS mlocate" # The plocate provides locate and updatedb. # ZYPP_INS="$ZYPP_INS plocate" # FAIL: `'plocate' not found in package names`. # The plocate provides locate and updatedb which are faster than mlocate <https://plocate.sesse.net>. # The mlocate provides locate and updatedb which are faster than findutils. # BREW_INS="$BREW_INS findutils" # The findutils provides locate and updatedb.
ZYPP_INS="$ZYPP_INS sudo" # The super user do.

# Server.
BREW_INS="$BREW_INS pure-ftpd" # ZYPP_INS="$ZYPP_INS pure-ftpd" # Pure-FTPd should be used because vsftpd is annoying <https://en.wikipedia.org/wiki/Pure-FTPd> <https://github.com/jedisct1/pure-ftpd>.
ZYPP_INS="$ZYPP_INS fail2ban"
ZYPP_INS="$ZYPP_INS knot" # DNS server.

# Data compression algorithms.
