# Common packages <sup><sub>User space packages.</sub></sup>
# ZYPP_INS="$ZYPP_INS rpmconf" # Tool to handle rpmnew and rpmsave files
# BREW_INS="$BREW_INS awk" # Text processing scripting language <https://en.wikipedia.org/wiki/AWK>.
# ZYPP_INS="$ZYPP_INS zstd" # instead install from homebrew # a-la gz/xz compression
BREW_INS="$BREW_INS dos2unix" # ZYPP_INS="$ZYPP_INS dos2unix" # Convert text file line endings between CRLF and LF.
