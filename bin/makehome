# Searching and grepping <sup><sub>tools and utilities</sub></sup>.
# BREW_INS="$BREW_INS sift"
# BREW_INS="$BREW_INS the_platinum_searcher" # DEPRECATED `pt` a-la `ag` (The Silver Searcher) <https://github.com/monochromegane/the_platinum_searcher>.
BREW_INS="$BREW_INS ack" # A-la ag <https://github.com/beyondgrep/ack3>.
BREW_INS="$BREW_INS fd" # Required by Emacs `fd-dired`. # RUST_INS="$RUST_INS fd-find" # `fd` is a find in filesystem but `find` incompatible <https://github.com/sharkdp/fd>.
BREW_INS="$BREW_INS pcre2" # Provides `pcre2grep -r your-regexp .` utility. PCRE2 is a Perl compatible regular expressions library with a new API <https://github.com/pcre2project/pcre2>.
BREW_INS="$BREW_INS ripgrep" # RUST_INS="$RUST_INS ripgrep" # `rg` is a search tool a-la `ag` (The Silver Searcher) <https://github.com/burntsushi/ripgrep>.
BREW_INS="$BREW_INS the_silver_searcher" # ZYPP_INS="$ZYPP_INS silversearcher-ag" # The Silver Searcher `ag` is a code-searching tool a-la `ack` <https://github.com/ggreer/the_silver_searcher> # ZYPP_INS="$ZYPP_INS automake pkg-config libpcre3-dev zlib1g-dev liblzma-dev" # Compiltime dependency <https://github.com/ggreer/the_silver_searcher#building-from-source>.
BREW_INS="$BREW_INS ugrep" # ugrep provides `ug` utility a-la grep and ag (the silver searcher) rg (the platinum searcher) all in one <https://github.com/genivia/ugrep>.

# Hash sum.
BREW_INS="$BREW_INS coreutils" # Provides `md5sum`/`sha1sum`/`sha256sum` utility <https://github.com/coreutils/coreutils>.
BREW_INS="$BREW_INS rhash" # Provides `crc32`/`md5`/`sha1`/`sha256` utility <https://github.com/rhash/rhash>.

# Git.
BREW_INS="$BREW_INS git" # Distributed version/revision control system <https://github.com/git/git>. # ZYPP_INS="$ZYPP_INS git"
BREW_INS="$BREW_INS git-delta" # Syntax-highlighting pager for git and diff output <https://github.com/dandavison/delta>.
BREW_INS="$BREW_INS git-flow" # <https://github.com/nvie/gitflow>.
BREW_INS="$BREW_INS git-lfs" # <https://git-lfs.com>.
BREW_INS="$BREW_INS git-who" # Git contributors list by lines number `git-who -l` <https://github.com/sinclairtarget/git-who>.
BREW_INS="$BREW_INS gitui" # Git TUI a-la tig <https://github.com/extrawurst/gitui>.
BREW_INS="$BREW_INS lazygit" # lazygit - TUI Git interactive client <https://github.com/jesseduffield/lazygit>.
BREW_INS="$BREW_INS tig" # ZYPP_INS="$ZYPP_INS tig" # Tig - TUI Git interactive client <https://github.com/jonas/tig>, <https://en.wikipedia.org/wiki/Tig_(software)>.

# Portable package management system <sup><sub>Standalone cross Linux distribution</sub></sup>.
