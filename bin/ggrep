. "$(cd -- "$(dirname -- "$0")" >/dev/null 2>&1 && pwd -P)/path.sh"

# ugrep provides `ug` utility a-la grep and ag (the silver searcher) rg (the platinum searcher) all in one <https://github.com/genivia/ugrep>.
"$BREWBINDIR"/ug "$@"
