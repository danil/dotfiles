. "$(cd -- "$(dirname -- "$0")" >/dev/null 2>&1 && pwd -P)/gitmir.sh"

gitmircfg "$@"

# gitmir -p -d "$(eval echo '~danil')/git/instapaper.git"               -m "github"        -b "master"
gitmir -c -d "$(eval echo '~danil')/git/md/hr.git"                    -m "github gitverse gitflic" -b "master"
gitmir -c -d "$(eval echo '~danil')/git/md/rcc.git"                   -m "github gitverse gitflic gitlab" -b "master"
gitmir -c -d "$(eval echo '~danil')/git/md/textsync.git"              -m "github gitverse gitflic gitlab" -b "master"
gitmir -c -d "$(eval echo '~git')/dotfiles.git"                       -m "github gitverse gitlab"         -b "h41-ubuntu-danil h36-ubuntu-danil h27-suse-danil" # gitmir -d "$(eval echo '~git')/dotfiles.git" -m "gitflic" -b "h41-ubuntu-danil h36-ubuntu-danil h27-suse-danil" # FAIL: error: remote unpack failed: error Pack exceeds the limit of 104 857 600 bytes, rejecting the pack (n/a (unpacker error))
gitmir -c -d "$(eval echo '~git')/el/init.el.git"                     -m "github gitverse gitflic gitlab" -b "master trash"
gitmir -c -d "$(eval echo '~git')/etc.git"                            -m "github gitverse gitflic gitlab" -b "h41-ubuntu h36-ubuntu h27-suse"
gitmir -c -d "$(eval echo '~git')/kernels.git"                        -m "github gitverse gitflic gitlab" -b "h10-gentoo"
gitmir -c -d "$(eval echo '~git')/keys.git"                           -m "github gitverse gitflic gitlab" -b "master"
gitmir -c -d "$(eval echo '~git')/md/rc.git"                          -m "github gitverse gitflic gitlab" -b "master"
gitmir -c -d "$(eval echo '~git')/root.git"                           -m "github gitverse gitflic gitlab" -b "h41-ubuntu h36-ubuntu h27-suse"
gitmir -c -d "$(eval echo '~git')/vimrc.git"                          -m "github gitverse gitflic gitlab" -b "master"
gitmir -p -d "$(eval echo '~git')/cv.git"                             -m "github gitverse gitflic gitlab" -b "v3 v2 v1"
gitmir -p -d "$(eval echo '~git')/example.git"                        -m "bitbucket"     -b "a c b10"
gitmir -p -d "$(eval echo '~git')/go/sqltee.git"                      -m "github"        -b "master"
gitmir -p -d "$(eval echo '~git')/sh/rsa_signature_example.git"       -m "bitbucket"     -b "master"
gitmir -p -d "$(eval echo '~git')/utils.git"                          -m "github gitlab" -b "master"
