https://askubuntu.com/questions/1393822/awake-pc-from-sleep-using-only-one-button
https://www.google.com/search?q=linux+%22%2Fproc%2Facpi%22+sleep+%22wake%22+only+%22power%22+button&oq=linux+%22%2Fproc%2Facpi%22+sleep+%22wake%22+only+%22power%22+button&gs_lcrp=EgZjaHJvbWUyBggAEEUYOTIKCAEQABiABBiiBDIKCAIQABiABBiiBNIBCTEzMDEzajBqMagCALACAA&sourceid=chrome&ie=UTF-8
https://askubuntu.com/questions/1250564/how-to-resume-from-suspend-or-hibernate-only-by-the-power-button
https://unix.stackexchange.com/questions/417956/make-changes-to-proc-acpi-wakeup-permanent/532839#532839
https://wiki.archlinux.org/title/Systemd#systemd-tmpfiles_-_temporary_files
https://wiki.archlinux.org/title/DSDT
https://bbs.archlinux.org/viewtopic.php?id=184553




for device in XHC
do
    if grep -q "$device.*enabled" /proc/acpi/wakeup
    then
        echo $device > /proc/acpi/wakeup
    fi
done
