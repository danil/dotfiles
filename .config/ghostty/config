# Ghostty Configuration
# <https://ghostty.org/docs/config#xdg-configuration-path-(all-platforms):>.

# <https://github.com/ghostty-org/ghostty/discussions/3663#discussioncomment-11696943>.
# Window decoration [ auto client server false ].
# window-decoration = auto
# gtk-titlebar = false

# <https://ghostty.org/docs/config/reference#link>,
# <https://github.com/ghostty-org/ghostty/issues/1972#issuecomment-2240048536>,
# <https://reddit.com/r/Ghostty/comments/1hwh9f9/linkurl_doesnt_work_with_tmux>.
# link-url = true

font-family = "Monospace"
# font-family = "PragmataPro Mono Liga"
# Iosevka SS08 is a PragmataPro variant
# <https://github.com/ghostty-org/ghostty/discussions/4495#discussioncomment-12200250>.
# font-family = "Iosevka SS08"
# font-feature = "-dlig"
# font-family = "Iosevka"
# font-family = "Fantasque Sans Mono"
font-size = "19"
# cursor-style = "block"
cursor-style-blink = ""

# <https://ghostty.org/docs/features/theme>,
# <https://ghostty.org/docs/config/reference#theme>.
# <https://ghostty.org/docs/config/reference#palette>,
# <https://wiki.gentoo.org/wiki/Ghostty#Custom_themes>,
# <https://github.com/ghostty-org/ghostty/issues/2685>.
theme = light:light.conf,dark:dark.conf

# Disabling default keymap
# <https://github.com/ghostty-org/ghostty/discussions/5415#discussioncomment-11991891>.
keybind = clear

keybind = ctrl+zero=reset_font_size
keybind = ctrl+minus=decrease_font_size:1
keybind = ctrl+plus=increase_font_size:1
keybind = ctrl+equal=increase_font_size:1

keybind = ctrl+insert=copy_to_clipboard
keybind = shift+insert=paste_from_selection

# keybind = ctrl+enter=toggle_fullscreen

